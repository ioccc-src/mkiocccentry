.sp
\fB#define fprstr(stream, fmt) fpr((stream), __func__, (fmt))\fP
.sp
\fB#define print(fmt, ...) pr(__func__, (fmt), __VA_ARGS__)\fP
.sp
\fB#define prstr(fmt) pr(__func__, (fmt))\fP
.sp
